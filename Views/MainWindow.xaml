<Window x:Class="PdrExamApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdrExamApp.ViewModels"
        Title="ПДР Екзамен - Комплекс підготовки" Height="780" Width="940"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">

    <Window.DataContext>
        <vm:ExamViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.06" Color="#000000"/>

        <!-- Стиль авто-приховування рамки картинки -->
        <Style x:Key="QuestionBorderStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentQuestion.ImagePath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentQuestion.ImagePath}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Хедер з онлайн-статусом -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10" Padding="18,14" Margin="0,0,0,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚘 ПДР Екзамен" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,4" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSourceStatus}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Visibility="{Binding IsExamActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,5" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " Foreground="#F59E0B" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TimerText}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ProgressText}" Foreground="#E2E8F0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Основна зона -->
        <Grid Grid.Row="1">

            <!-- 1. ГОЛОВНИЙ ЕКРАН -->
            <Border Background="White" CornerRadius="14" Padding="35" VerticalAlignment="Center" HorizontalAlignment="Center" Width="700"
                    Effect="{StaticResource CardShadow}"
                    Visibility="{Binding IsStartPageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Навчальний комплекс ПДР України" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Завантаження питань виконується в реальному часі з онлайн-джерела" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Режим 1 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="⏱ Симуляція іспиту СЦ МВС" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="10 онлайн питань, таймер на 20 хвилин, випадкова вибірка." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Розпочати іспит" Command="{Binding StartFullExamCommand}" Style="{StaticResource PrimaryBtn}" Width="160" Height="42" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Режим 2 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="📚 Тематичне тренування" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Оберіть конкретну категорію питань:" FontSize="13" Foreground="#64748B" Margin="0,0,0,15"/>

                            <DockPanel>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                                          FontSize="14" Padding="10,6" Height="42" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                                <Button Content="Тренуватися" Command="{Binding StartTopicExamCommand}" Style="{StaticResource SuccessBtn}" Width="160" Height="42" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Блок мережевої помилки -->
                    <Border Background="#FEE2E2" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                            Visibility="{Binding HasNetworkError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Button Content="Спробувати знову" Command="{Binding RetryNetworkCommand}" Style="{StaticResource PrimaryBtn}" DockPanel.Dock="Right" Padding="10,4" FontSize="12"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. ЕКРАН ТЕСТУВАННЯ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          Visibility="{Binding IsExamActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- Панель номерів питань (1..10) -->
                    <Border Background="White" CornerRadius="10" Padding="10,8" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                        <ItemsControl ItemsSource="{Binding ActiveQuestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="38" Height="38" Margin="4,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" 
                                                        Background="{Binding StatusColor}" 
                                                        BorderBrush="{Binding BorderColor}" 
                                                        BorderThickness="2.5" 
                                                        CornerRadius="8">
                                                    <TextBlock Text="{Binding DisplayIndex}" 
                                                               Foreground="{Binding TextColor}" 
                                                               FontSize="14" 
                                                               FontWeight="Bold" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Картка питання -->
                    <Border Background="White" CornerRadius="10" Padding="22" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentQuestion.Category}" Foreground="#64748B" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CurrentQuestion.Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,0,0,14"/>

                            <!-- Картинка знака/ситуації -->
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,10" HorizontalAlignment="Center"
                                    Style="{StaticResource QuestionBorderStyle}">
                                <Image Source="{Binding CurrentQuestion.ImagePath}" 
                                       MaxHeight="180" 
                                       MaxWidth="320"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Варіанти відповідей -->
                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                        <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BackgroundColor}" CornerRadius="8" Padding="12,8" Margin="0,4">
                                        <RadioButton Content="{Binding Text}" 
                                                     GroupName="Options"
                                                     FontSize="15" 
                                                     Foreground="{Binding TextColor}"
                                                     Checked="Option_Checked"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Пояснення -->
                    <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12"
                            Visibility="{Binding IsAnswered, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResultMessage}" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding AiAnalysis}" FontSize="14" TextWrapping="Wrap" Foreground="#166534"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. ФІНАЛЬНИЙ ЕКРАН -->
            <Border Background="White" CornerRadius="14" Padding="35" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Effect="{StaticResource CardShadow}"
                    Visibility="{Binding IsExamFinished, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Іспит завершено!" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ScoreText}" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="На головну" Command="{Binding ReturnToHomeCommand}" Style="{StaticResource PrimaryBtn}" Width="150" Height="42" Margin="0,0,10,0"/>
                        <Button Content="Пройти ще раз" Command="{Binding StartFullExamCommand}" Style="{StaticResource SuccessBtn}" Width="150" Height="42"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Індикатор завантаження -->
            <Border Background="#80000000" CornerRadius="14" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="6" Margin="0,0,0,12"/>
                    <TextBlock Text="Отримання даних з мережі..." Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Підвал -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding IsExamActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Content="← На головну" Command="{Binding ReturnToHomeCommand}" Background="Transparent" Foreground="#64748B" FontSize="13" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Left"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Відповісти" Command="{Binding SubmitCommand}" 
                        Style="{StaticResource SuccessBtn}"
                        Width="140" Height="42" Margin="0,0,10,0"/>

                <Button Content="Наступне ➔" Command="{Binding NextCommand}" 
                        Style="{StaticResource PrimaryBtn}"
                        Width="150" Height="42"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>